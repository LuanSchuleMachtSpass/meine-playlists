<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="7dp"
    android:paddingEnd="16dp" android:paddingBottom="7dp">
    <ImageView android:id="@+id/cover" android:layout_width="58dp" android:layout_height="58dp"
        android:background="@color/surface" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="14dp">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="2" android:textColor="@color/text" android:textSize="16sp" />
        <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/text2" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
