<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
    <ImageView android:id="@+id/h_cover" android:layout_width="190dp" android:layout_height="190dp"
        android:background="@color/surface" android:scaleType="centerCrop" />
    <TextView android:id="@+id/h_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center" android:textColor="@color/text"
        android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/h_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/text2" android:textSize="13sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:orientation="horizontal">
        <Button android:id="@+id/h_play" android:layout_width="wrap_content" android:layout_height="44dp"
            android:background="@drawable/btn_primary" android:paddingStart="26dp" android:paddingEnd="26dp"
            android:text="Abspielen" android:textAllCaps="false" android:textColor="@color/on_accent" android:textStyle="bold" />
        <Button android:id="@+id/h_shuffle" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="12dp" android:background="@drawable/btn_secondary" android:paddingStart="26dp"
            android:paddingEnd="26dp" android:text="Zufällig" android:textAllCaps="false" android:textColor="@color/text" />
    </LinearLayout>
</LinearLayout>
