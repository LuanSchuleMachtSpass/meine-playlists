<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fitsSystemWindows="true">

    <!-- Hauptbereich: Kopfzeile, Suche, Liste, Mini-Player -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="8dp" android:paddingEnd="16dp">
            <ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Zurück"
                android:src="@drawable/ic_back" android:visibility="gone" />
            <TextView android:id="@+id/header_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:ellipsize="end" android:paddingStart="8dp" android:singleLine="true"
                android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold" />
        </LinearLayout>

        <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp"
            android:background="@drawable/field_bg" android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp" android:hint="Songs, Künstler, MP3s suchen"
            android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="12dp"
            android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/text"
            android:textColorHint="@color/text2" android:textSize="15sp" />

        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipToPadding="false" android:divider="@null"
            android:dividerHeight="0dp" android:paddingBottom="8dp" android:scrollbars="none" />

        <!-- Mini-Player als schwebende Karte -->
        <LinearLayout android:id="@+id/mini" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp"
            android:background="@drawable/mini_bg" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="62dp"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="8dp" android:paddingEnd="6dp">
                <ImageView android:id="@+id/mini_cover" android:layout_width="46dp" android:layout_height="46dp"
                    android:background="@color/surface" android:scaleType="centerCrop" android:src="@drawable/ic_note" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
                    <TextView android:id="@+id/mini_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:ellipsize="end" android:singleLine="true" android:textColor="@color/text"
                        android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/mini_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:ellipsize="end" android:singleLine="true" android:textColor="@color/text2" android:textSize="12sp" />
                </LinearLayout>
                <ImageButton android:id="@+id/mini_play" android:layout_width="46dp" android:layout_height="46dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Play/Pause"
                    android:src="@drawable/ic_play_white" />
                <ImageButton android:id="@+id/mini_next" android:layout_width="46dp" android:layout_height="46dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Weiter"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
            <ProgressBar android:id="@+id/mini_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="4dp"
                android:max="1000" android:progressDrawable="@drawable/mini_progress" />
        </LinearLayout>
    </LinearLayout>

    <!-- Großer Player, gleitet von unten herein -->
    <FrameLayout android:id="@+id/now" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clickable="true" android:focusable="true" android:visibility="gone">
        <View android:id="@+id/now_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#1B1B1E" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="4dp"
            android:paddingEnd="24dp" android:paddingBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/now_close" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Schließen"
                    android:src="@drawable/ic_down" />
                <TextView android:id="@+id/now_source" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:singleLine="true" android:ellipsize="end"
                    android:text="Jetzt läuft" android:textColor="#CCFFFFFF" android:textSize="13sp" />
                <ImageButton android:id="@+id/now_queue" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Warteschlange"
                    android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_queue" />
            </LinearLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <de.meineplaylists.SquareImageView android:id="@+id/np_cover" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:layout_gravity="center"
                    android:background="#2A2A2E" android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView android:id="@+id/np_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFF"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/np_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:ellipsize="end" android:singleLine="true"
                android:textColor="#B3FFFFFF" android:textSize="16sp" />

            <SeekBar android:id="@+id/np_seek" android:layout_width="match_parent" android:layout_height="32dp"
                android:layout_marginStart="-16dp" android:layout_marginTop="14dp" android:layout_marginEnd="-16dp"
                android:max="1000" android:progressDrawable="@drawable/seek_track" android:thumb="@drawable/seek_thumb"
                android:splitTrack="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/np_left" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="#99FFFFFF" android:textSize="12sp" />
                <TextView android:id="@+id/np_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/np_shuffle" android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Zufällig" android:src="@drawable/ic_shuffle" />
                <ImageButton android:id="@+id/np_prev" android:layout_width="0dp" android:layout_height="56dp"
                    android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Zurück" android:padding="12dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev" />
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3">
                    <ImageButton android:id="@+id/np_play" android:layout_width="72dp" android:layout_height="72dp"
                        android:layout_gravity="center" android:background="@drawable/play_big"
                        android:contentDescription="Play/Pause" android:padding="20dp" android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_dark" />
                </FrameLayout>
                <ImageButton android:id="@+id/np_next" android:layout_width="0dp" android:layout_height="56dp"
                    android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Weiter" android:padding="12dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_next" />
                <ImageButton android:id="@+id/np_repeat" android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Wiederholen" android:src="@drawable/ic_repeat" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_volume" />
                <SeekBar android:id="@+id/np_volume" android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:max="100" android:progressDrawable="@drawable/seek_track"
                    android:thumb="@drawable/seek_thumb" android:splitTrack="false" />
            </LinearLayout>
            <TextView android:id="@+id/np_device" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center" android:singleLine="true" android:ellipsize="end"
                android:textColor="#99FFFFFF" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
