<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fitsSystemWindows="true" android:orientation="vertical">

    <!-- Kopfzeile -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="8dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Zurück"
            android:src="@drawable/ic_back" android:visibility="gone" />
        <TextView android:id="@+id/header_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:paddingStart="8dp" android:singleLine="true"
            android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:divider="@null" android:dividerHeight="0dp"
            android:paddingBottom="8dp" android:scrollbars="none" />

        <!-- Jetzt läuft -->
        <LinearLayout android:id="@+id/now" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingStart="28dp" android:paddingTop="8dp" android:paddingEnd="28dp" android:paddingBottom="20dp"
            android:visibility="gone">
            <de.meineplaylists.SquareImageView android:id="@+id/np_cover" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:background="@color/surface"
                android:scaleType="centerCrop" />
            <TextView android:id="@+id/np_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:ellipsize="end" android:maxLines="2"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/np_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:ellipsize="end" android:singleLine="true"
                android:textColor="@color/text2" android:textSize="16sp" />
            <ProgressBar android:id="@+id/np_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="20dp"
                android:max="1000" android:progressDrawable="@drawable/np_progress" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="horizontal">
                <TextView android:id="@+id/np_left" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/text2" android:textSize="12sp" />
                <TextView android:id="@+id/np_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text2" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/np_prev" android:layout_width="60dp" android:layout_height="60dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Zurück"
                    android:scaleType="fitCenter" android:padding="14dp" android:src="@drawable/ic_prev" />
                <ImageButton android:id="@+id/np_play" android:layout_width="72dp" android:layout_height="72dp"
                    android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:background="@drawable/play_circle"
                    android:contentDescription="Play/Pause" android:scaleType="fitCenter" android:padding="18dp"
                    android:src="@drawable/ic_play_dark" />
                <ImageButton android:id="@+id/np_next" android:layout_width="60dp" android:layout_height="60dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Weiter"
                    android:scaleType="fitCenter" android:padding="14dp" android:src="@drawable/ic_next" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_volume" />
                <SeekBar android:id="@+id/np_volume" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:max="100" />
            </LinearLayout>
            <TextView android:id="@+id/np_device" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center" android:singleLine="true"
                android:textColor="@color/text2" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Mini-Player -->
    <LinearLayout android:id="@+id/mini" android:layout_width="match_parent" android:layout_height="66dp"
        android:background="@color/surface" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingEnd="6dp">
        <ImageView android:id="@+id/mini_cover" android:layout_width="46dp" android:layout_height="46dp"
            android:scaleType="centerCrop" android:src="@drawable/ic_note" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/mini_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:singleLine="true" android:textColor="@color/text" android:textSize="14sp" />
            <TextView android:id="@+id/mini_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:singleLine="true" android:textColor="@color/text2" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/mini_prev" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Zurück"
            android:src="@drawable/ic_prev" />
        <ImageButton android:id="@+id/mini_play" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/play_circle"
            android:contentDescription="Play/Pause" android:src="@drawable/ic_play_dark" />
        <ImageButton android:id="@+id/mini_next" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Weiter"
            android:src="@drawable/ic_next" />
    </LinearLayout>
</LinearLayout>
