<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/body_bg" android:fitsSystemWindows="true"
    android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="22dp"
    android:paddingEnd="22dp" android:paddingBottom="18dp">

    <!-- Bildschirm -->
    <LinearLayout android:id="@+id/screen" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/screen_bg" android:orientation="vertical"
        android:padding="3dp">

        <!-- Kopfzeile -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="14dp" android:paddingEnd="12dp">
            <TextView android:id="@+id/header_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:ellipsize="end" android:singleLine="true"
                android:textColor="#E8E8EC" android:textSize="14sp" android:textStyle="bold" />
            <ImageView android:id="@+id/header_state" android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/ic_hplay" android:visibility="invisible" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <!-- Menülisten -->
            <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
                android:divider="@null" android:dividerHeight="0dp" android:padding="6dp" android:clipToPadding="false"
                android:scrollbars="none" android:listSelector="@android:color/transparent" />

            <!-- Jetzt läuft -->
            <LinearLayout android:id="@+id/now" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <de.meineplaylists.SquareImageView android:id="@+id/np_cover" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="0.46"
                        android:background="#1E1E22" android:scaleType="centerCrop" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.54" android:orientation="vertical" android:paddingStart="16dp">
                        <TextView android:id="@+id/np_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:ellipsize="end" android:maxLines="3" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:id="@+id/np_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2"
                            android:textColor="#B4B4BC" android:textSize="15sp" />
                        <TextView android:id="@+id/np_device" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:ellipsize="end" android:singleLine="true"
                            android:textColor="#7C7C86" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <ProgressBar android:id="@+id/np_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="16dp"
                    android:max="1000" android:progressDrawable="@drawable/np_progress" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:orientation="horizontal">
                    <TextView android:id="@+id/np_left" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="#8A8A92" android:textSize="12sp" />
                    <TextView android:id="@+id/np_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#8A8A92" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Klickrad -->
    <de.meineplaylists.ClickWheelView android:id="@+id/wheel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="26dp" />
</LinearLayout>
