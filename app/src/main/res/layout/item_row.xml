<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="10dp" android:paddingEnd="6dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textSize="16sp" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/chevron" android:layout_width="20dp" android:layout_height="20dp"
        android:src="@drawable/ic_chevron" />
</LinearLayout>
