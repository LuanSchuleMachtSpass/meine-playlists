<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_bar"
    android:layout_width="match_parent" android:layout_height="68dp"
    android:background="@color/surface" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="6dp">
    <ImageView android:id="@+id/pb_cover" android:layout_width="48dp" android:layout_height="48dp"
        android:scaleType="centerCrop" android:src="@drawable/ic_note" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/pb_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textColor="@color/text" android:textSize="14sp" />
        <TextView android:id="@+id/pb_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textColor="@color/text2" android:textSize="12sp" />
    </LinearLayout>
    <ImageButton android:id="@+id/pb_prev" android:layout_width="44dp" android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Zurück"
        android:src="@drawable/ic_prev" />
    <ImageButton android:id="@+id/pb_play" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:contentDescription="Play/Pause"
        android:background="@drawable/play_circle" android:src="@drawable/ic_play" />
    <ImageButton android:id="@+id/pb_next" android:layout_width="44dp" android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Weiter"
        android:src="@drawable/ic_next" />
</LinearLayout>
